[alias]
    b = branch
    c = commit
    s = status
    co = checkout
    d = diff --compact-summary
    dt = difftool --dir-diff --no-symlinks
    lgb = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(cyan)<%an>%Creset%n' --abbrev-commit --date=relative --branches

